{
  "name": "@nfw/screening",
  "version": "0.0.0",
  "private": true,
  "description": "Eligibility screening rules engine. Pure functions, shared by the app (preview) and the API (authoritative).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --clean && tsc -p tsconfig.build.json",
    "dev": "tsup src/index.ts --format esm,cjs --watch --onSuccess \"tsc -p tsconfig.build.json\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nfw/config": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.3"
  }
}
