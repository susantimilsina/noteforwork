{
  "name": "@nfw/db",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma schema, migrations, seed and the typed DB client.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsup src/index.ts --format cjs --clean --external @prisma/client --external @prisma/adapter-pg && tsc -p tsconfig.build.json",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio",
    "typecheck": "prisma generate && tsc --noEmit",
    "seed:demo": "tsx prisma/seed-demo.ts"
  },
  "dependencies": {
    "@nfw/schemas": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0"
  },
  "devDependencies": {
    "@nfw/config": "workspace:*",
    "@types/node": "^22",
    "dotenv": "^17.2.0",
    "prisma": "^7.10.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.0",
    "typescript": "~6.0.2"
  }
}
